{
  "name": "hexapod_controller",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm proto && vite dev --host",
    "proto": "node scripts/compile_protos.js",
    "build": "pnpm proto && vite build",
    "build:embedded": "pnpm proto && cross-env VITE_USE_HOST_NAME=true vite build",
    "preview": "vite preview",
    "test": "pnpm run test:integration && pnpm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.1.64",
    "@iconify-json/tabler": "^1.1.109",
    "@niku/vite-env-caster": "^1.0.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.12",
    "@types/three": "^0.162.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.45.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-focus-trap": "^1.2.0",
    "tailwindcss": "^4.0.12",
    "ts-proto": "^2.10.1",
    "ts-proto-descriptors": "^2.1.0",
    "tslib": "^2.6.1",
    "typescript": "^5.5.0",
    "unplugin-icons": "^0.18.5",
    "vite": "^6.2.1",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "chart.js": "^4.4.2",
    "compare-versions": "^6.1.0",
    "daisyui": "^5.0.0",
    "nipplejs": "^0.10.1",
    "svelte-dnd-list": "^0.1.8",
    "svelte-modals": "^2.0.0",
    "three": "^0.162.0",
    "urdf-loader": "^0.12.1",
    "xacro-parser": "^0.3.9"
  }
}
