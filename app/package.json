{
  "name": "hexapod_controller",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "pnpm proto && pnpm virtual-robot && vite dev --host",
    "proto": "node scripts/compile_protos.js",
    "virtual-robot": "node scripts/build_virtual_robot.js",
    "build": "pnpm proto && pnpm virtual-robot && vite build",
    "build:embedded": "pnpm proto && cross-env VITE_USE_HOST_NAME=true vite build",
    "preview": "vite preview",
    "test": "pnpm run test:integration && pnpm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "node scripts/check_virtual_robot.js && vitest run"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.42",
    "@niku/vite-env-caster": "^1.2.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.162.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-focus-trap": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "ts-proto": "^2.15.3",
    "ts-proto-descriptors": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^0.18.5",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@mujoco/mujoco": "3.14.0",
    "chart.js": "^4.5.1",
    "compare-versions": "^6.1.1",
    "daisyui": "^5.7.50",
    "nipplejs": "^0.10.2",
    "svelte-dnd-list": "^0.1.8",
    "svelte-modals": "^2.0.1",
    "three": "^0.162.0",
    "urdf-loader": "^0.12.7",
    "xacro-parser": "^0.3.11"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.2",
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
