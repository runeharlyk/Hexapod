# Baseline ESP-IDF configuration for the Hexapod (ESP32-S3 WROOM cam).
# Board-specific overrides go in sdkconfig.defaults.<target> if other chips are added later.

# HTTP server WebSocket support (replaces PsychicHttp)
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# mDNS
CONFIG_MDNS_MAX_SERVICES=10

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=3

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 1 kHz tick so the 5 ms (200 Hz) control loop has resolution. ESP-IDF defaults to 100 Hz
# (10 ms tick), under which pdMS_TO_TICKS(5) rounds to 0 and vTaskDelayUntil asserts. Arduino
# defaulted to 1 kHz, so this restores the pre-migration timing.
CONFIG_FREERTOS_HZ=1000

# Task stacks. The sys_evt task runs the WiFi/IP event handlers, including the ESP-NOW and service
# callbacks, which the 2304 B default leaves little headroom for.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Console on UART0 only. The native USB Serial/JTAG port carries the protobuf serial link
# (communication/serial_adapter.h), so log output must not be mirrored onto it.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS run-time stats: per-core CPU usage in analytics (idle-task counters over esp_timer) and the metrics page's
# task table (include/task_stats.h). The core ID puts each task's pinned core in uxTaskGetSystemState's snapshot, read
# under the kernel's lock; its Kconfig depends on the formatting functions, which GENERATE_RUN_TIME_STATS selects and
# which nothing calls, so the linker drops them. The explicit line only states the dependency.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Software AES + SHA. The hardware crypto drivers allocate DMA buffers from internal RAM, which is
# exhausted once BLE + WiFi(STA+AP) + coexistence + camera are up, failing the WPA2 handshake
# ("esp-aes"/"esp-sha: Failed to allocate ... memory" -> STA auth fail, reason 202). Software crypto
# needs no DMA and the cost is trivial for occasional handshakes and the OTA download's TLS session.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_SHA=n

# Octal PSRAM on the S3 WROOM module (matches Arduino memory_type qio_opi)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Push WiFi/LWIP buffers into PSRAM so the BLE controller + HCI keep enough internal DMA RAM
# (BLE inits after WiFi/AP; HCI-buffer allocation was starving of internal RAM).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi internal-DMA pools: the static RX pool and the TX cache buffers live in internal DMA RAM.
# At defaults (RX 16, cache 32) they leave nothing for the SoftAP beacon/hostap allocations once
# BLE + camera are up, so ieee80211_hostap_attach null-derefs. Trim both; dynamic RX/TX already
# spill to PSRAM via the prefer-SPIRAM flag above.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# Keep WiFi TX/RX code in flash instead of IRAM. On the S3 (unified internal SRAM) this returns
# ~28 KB of DRAM-capable heap to the pool, which the BT controller needs to coexist with the camera
# + SoftAP without "BLE_INIT: Malloc failed". Cost is WiFi throughput/latency (code runs cached).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Camera DMA line-buffer must come from internal DMA RAM, which is tight after BLE+WiFi+AP. Cap it
# (default 32 KB -> it picked 16 KB and failed; ~14 KB contiguous is all that's left) so it fits.
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partition table (file set via board_build.partitions in platformio.ini)
CONFIG_PARTITION_TABLE_CUSTOM=y

# Compiler; stack canaries catch a smashed stack where it happens, not later as a stray crash.
# NORM, not STRONG: STRONG crashes GCC 14.2 on esp-dsp's dspi_conv_f32_ansi.c (seen on the SpotMicro build).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# Core dumps go to the coredump partition of the partition table, in ELF so idf.py coredump-info
# can decode them after a crash.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The dump names the crashed firmware by its ELF's SHA-256 in this many hex digits, from a RAM copy of the string
# (55 bytes more than the default 9): all 64, so the status page matches it against a build's full hash.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

# A task the task watchdog watches that does not reset it for 5 s panics the board, which writes the core dump and
# restarts; the restart puts both PCA9685 boards to sleep. Watched: the control task (main.cpp) and, as the IDF
# default, both idle tasks, which now restart the board too instead of only logging. 5 s is the IDF default and over
# twice the longest stall of a control tick that is not hung, about 2.2 s (docs/firmware.md, Task watchdog).
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Bluetooth / NimBLE (peripheral role for the NUS transport)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# The BT controller can only allocate from internal RAM; the NimBLE host can't. Move the host's
# mbuf/HCI pools (~18 KB) to PSRAM so the controller keeps its internal headroom when WiFi SoftAP is
# also up, otherwise runtime notifies fail with "BLE_INIT: Malloc failed". One web-app client only,
# so drop the connection count from the default 3.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# OTA: roll back to the previous slot unless the new image marks itself valid on first boot
# (ota_service::confirmRunningImage). Without this a bad update boot-loops with no way back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The https download fetches from GitHub, which redirects to a second host, so the image needs the
# public root-CA bundle rather than a pinned certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Keep the TLS session buffers (~16 KB) out of internal RAM: the OTA download runs while
# WiFi, BLE and the camera already hold their internal allocations.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# BLE controller footprint: ~64 KB of internal RAM at defaults, which starved the SoftAP. The NUS
# transport only advertises and takes one connection, so the scan path and the spare activity slots
# (828 B each) are unreachable. RUN_IN_FLASH_ONLY saves the most (>20 KB out of IRAM); its cost is
# degraded BLE while flash is erasing.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_DTM_ENABLE=n

# A TCP connection sends one send buffer per round trip (about 20 ms here), which held a camera stream to about
# 10 fps; 23 KB doubles it (one viewer 20 fps, three 9 fps each, measured 2026-10-16). lwIP buffers come from PSRAM
# (SPIRAM_TRY_ALLOCATE_WIFI_LWIP): internal free heap with three viewers read the same as with the 5.8 KB default.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
